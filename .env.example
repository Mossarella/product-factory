# ─── Supabase foundation ───────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# ─── Server-only test and administrative values ────────────────────────────────
# Never expose these through NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Production Auth configuration ─────────────────────────────────────────────
# Configure the Supabase Auth Site URL and redirect allow-list in the dashboard.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Etsy OAuth — server-only ───────────────────────────────────────────────────
# Register the exact callback URL in the Etsy developer application.
ETSY_API_KEYSTRING=your-etsy-keystring
ETSY_SHARED_SECRET=your-etsy-shared-secret
ETSY_REDIRECT_URI=http://localhost:3000/api/integrations/etsy/callback
# Optional: pin OAuth to your one authorized Etsy shop.
ETSY_ALLOWED_SHOP_ID=your-etsy-shop-id
# 32 random bytes encoded as base64 or 64 hexadecimal characters.
ETSY_TOKEN_ENCRYPTION_KEY=your-32-byte-encryption-key
# Optional; defaults to listings_r listings_w shops_r.
ETSY_SCOPES=listings_r listings_w shops_r

# ─── Stripe — one-time Creator billing ─────────────────────────────────────────
# Get the secret key from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Create a one-time Creator Price at https://dashboard.stripe.com/test/products
STRIPE_CREATOR_PRICE_ID=price_...
# Add this endpoint in Stripe Workbench/Webhooks and subscribe to:
# checkout.session.completed and payment_intent.succeeded
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Anthropic (AI features) ──────────────────────────────────────────────────
# Get from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# Optional — defaults to claude-sonnet-5 if unset. Swap for a different
# model without a code change (e.g. claude-opus-4-8 for higher quality,
# claude-haiku-4-5 for lowest cost).
ANTHROPIC_MODEL=claude-sonnet-5
