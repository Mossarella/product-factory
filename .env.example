# ─── Database ─────────────────────────────────────────────────────────────────
# Start with: docker compose up -d
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/product_factory

# ─── Auth.js (next-auth v5) ───────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-secret-here
AUTH_URL=http://localhost:3000

# ─── Resend (magic link email) ────────────────────────────────────────────────
# Get from https://resend.com/api-keys
RESEND_API_KEY=re_...
# Must be a verified sender domain in Resend
AUTH_EMAIL_FROM=Product Factory <noreply@yourdomain.com>

# ─── Stripe — license gate ────────────────────────────────────────────────────
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Create a payment link at https://dashboard.stripe.com/payment-links
STRIPE_CHECKOUT_URL=https://buy.stripe.com/...
